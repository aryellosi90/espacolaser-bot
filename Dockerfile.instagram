FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy

WORKDIR /app

# Dependências Python
COPY requirements.txt .
RUN pip install -r requirements.txt
RUN playwright install chromium

# Arquivos da automação de Instagram
# tokens.json NÃO é copiado de propósito — contém segredos (tokens do
# Instagram, app secret) e não deve ir pro repositório (que é público).
# Em produção ele é montado em runtime a partir da variável TOKENS_JSON
# (ver carregar_tokens() em instagram_poster.py e tokens.example.json).
COPY instagram_poster.py .
COPY token_helper.py .

# Agendamento: roda todo dia às 9h, 12h e 18h (horário de Brasília = UTC-3)
# Instala cron
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y cron tzdata && \
    ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime && \
    echo "America/Sao_Paulo" > /etc/timezone

# Crontab: 10h e 18h (horário de Brasília) — TZ explícito para garantir horário correto
RUN printf 'TZ=America/Sao_Paulo\n0 10 * * * . /etc/container_env; cd /app && python instagram_poster.py >> /app/poster.log 2>&1\n0 18 * * * . /etc/container_env; cd /app && python instagram_poster.py >> /app/poster.log 2>&1\n' | crontab -

# Variáveis de ambiente esperadas no Railway (Service → Variables):
# SISMAKER_LOGIN     — e-mail de login no Sismaker (obrigatório)
# SISMAKER_SENHA     — senha do Sismaker (obrigatório)
# TOKENS_JSON        — conteúdo inteiro do tokens.json numa linha só
#                      (obrigatório — ver tokens.example.json pro formato)
# IMGBB_API_KEY      — chave da API do imgbb.com (opcional — já dá pra
#                      colocar dentro do próprio TOKENS_JSON)
# IG_CAPTION         — legenda padrão dos posts (opcional)
# HEADLESS           — true (padrão)
# ZAPI_INSTANCE      — ID da instância Z-API (opcional — sem isso só pula a
# ZAPI_TOKEN           notificação por WhatsApp, não quebra o resto)
# ZAPI_CLIENT_TOKEN
# ZAPI_PHONE         — Número WhatsApp destino (ex: 5511964115060)

# Script de inicialização: salva env vars do Railway, cria log e sobe cron em foreground
# MODO TESTE — reverter após confirmar que funcionou:
# CMD sh -c 'printenv > /etc/container_env && touch /app/poster.log && cron && tail -f /app/poster.log'
CMD sh -c 'printenv > /etc/container_env && touch /app/poster.log && cron && python instagram_poster.py 2>&1 | tee -a /app/poster.log; tail -f /app/poster.log'
