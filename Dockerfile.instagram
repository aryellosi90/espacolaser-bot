FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy

WORKDIR /app

# Sem isso, o stdout do Python fica bufferizado quando não está preso a um
# terminal (caso do container) — os logs só apareciam com atraso/incompletos.
ENV PYTHONUNBUFFERED=1

# Dependências Python
COPY requirements.txt .
RUN pip install -r requirements.txt
RUN playwright install chromium

# Arquivos da automação de Instagram
# tokens.json NÃO é copiado de propósito — contém segredos (tokens do
# Instagram, app secret) e não deve ir pro repositório (que é público).
# Em produção ele é montado em runtime a partir da variável TOKENS_JSON
# (ver carregar_tokens() em instagram_poster.py e tokens.example.json).
COPY instagram_poster.py .
COPY token_helper.py .
COPY write_env.py .

# Agendamento: roda todo dia às 10h, 14h, 18h e 20h (horário de Brasília = UTC-3)
# Instala cron
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y cron tzdata && \
    ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime && \
    echo "America/Sao_Paulo" > /etc/timezone

# Crontab: 10h, 14h, 18h e 20h (horário de Brasília) — TZ explícito para
# garantir horário correto. ja_postou_hoje()/marcar_postado() já cuidam de
# não postar de novo nas execuções seguintes do mesmo dia, então rodar mais
# vezes só aumenta a chance de pegar a arte assim que o Sismaker publicar.
RUN printf 'TZ=America/Sao_Paulo\n0 10,14,18,20 * * * . /etc/container_env; cd /app && python instagram_poster.py >> /app/poster.log 2>&1\n' | crontab -

# Variáveis de ambiente esperadas no Railway (Service → Variables):
# SISMAKER_LOGIN     — e-mail de login no Sismaker (obrigatório)
# SISMAKER_SENHA     — senha do Sismaker (obrigatório)
# TOKENS_JSON        — conteúdo inteiro do tokens.json numa linha só
#                      (obrigatório — ver tokens.example.json pro formato)
# IMGBB_API_KEY      — chave da API do imgbb.com (opcional — já dá pra
#                      colocar dentro do próprio TOKENS_JSON)
# IG_CAPTION         — legenda padrão dos posts (opcional)
# HEADLESS           — true (padrão)
# ZAPI_INSTANCE      — ID da instância Z-API (opcional — sem isso só pula a
# ZAPI_TOKEN           notificação por WhatsApp, não quebra o resto)
# ZAPI_CLIENT_TOKEN
# ZAPI_PHONE         — Número WhatsApp destino (ex: 5511964115060)

# Script de inicialização: salva env vars do Railway, cria log e sobe cron em
# foreground. NÃO roda o poster imediatamente ao subir o container — só via
# cron (10h/14h/18h/20h) — porque cada redeploy sobe um container novo, e
# rodar na hora significa tentar postar de verdade toda vez que o serviço
# reiniciar,
# redeploy incluso (foi exatamente isso que causou uma postagem indesejada
# em 08/09/2026, com uma variável de teste antiga ainda configurada).
#
# write_env.py (não "printenv > arquivo" puro) grava as variáveis com
# escape de shell (shlex.quote) — sem isso, qualquer valor com aspas/chaves
# (como o TOKENS_JSON) quebra a leitura do arquivo pelo cron e derruba as
# variáveis seguintes junto (foi o que aconteceu em 09/09/2026: SISMAKER_LOGIN
# "sumiu" porque vinha depois do TOKENS_JSON no arquivo).
CMD sh -c 'python3 write_env.py && touch /app/poster.log && cron && tail -f /app/poster.log'
